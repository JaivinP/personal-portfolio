<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512" shape-rendering="geometricPrecision">

  <!-- Background -->
  <circle cx="256" cy="256" r="256" fill="#0a0a0f"/>

  <!-- Indigo ring -->
  <circle cx="256" cy="256" r="238" fill="none" stroke="#6366f1" stroke-width="7" stroke-opacity="0.38"/>

  <!-- Circuit trace: top — vertical stem + crossbar + terminal dots -->
  <line x1="256" y1="48"  x2="256" y2="118" stroke="#2dd4bf" stroke-width="5" stroke-opacity="0.42" stroke-linecap="square"/>
  <line x1="224" y1="80"  x2="288" y2="80"  stroke="#2dd4bf" stroke-width="3" stroke-opacity="0.24" stroke-linecap="square"/>
  <circle cx="224" cy="80" r="5" fill="#2dd4bf" fill-opacity="0.30"/>
  <circle cx="288" cy="80" r="5" fill="#2dd4bf" fill-opacity="0.30"/>

  <!-- Circuit trace: right — horizontal stem + crossbar + terminal dot -->
  <line x1="396" y1="256" x2="464" y2="256" stroke="#2dd4bf" stroke-width="5" stroke-opacity="0.42" stroke-linecap="square"/>
  <line x1="430" y1="224" x2="430" y2="288" stroke="#2dd4bf" stroke-width="3" stroke-opacity="0.24" stroke-linecap="square"/>
  <circle cx="464" cy="256" r="5" fill="#2dd4bf" fill-opacity="0.30"/>

  <!-- Circuit trace: bottom-left — L-bend -->
  <line x1="108" y1="388" x2="152" y2="388" stroke="#2dd4bf" stroke-width="5" stroke-opacity="0.38" stroke-linecap="square"/>
  <line x1="108" y1="388" x2="108" y2="432" stroke="#2dd4bf" stroke-width="5" stroke-opacity="0.38" stroke-linecap="square"/>
  <circle cx="152" cy="388" r="5" fill="#2dd4bf" fill-opacity="0.28"/>
  <circle cx="108" cy="432" r="5" fill="#2dd4bf" fill-opacity="0.28"/>

  <!-- JP monogram — bold, tight letter-spacing for monogram feel -->
  <text
    x="256" y="316"
    font-family="-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif"
    font-size="215"
    font-weight="800"
    fill="white"
    fill-opacity="0.95"
    text-anchor="middle"
    letter-spacing="-14">JP</text>

</svg>
